# Portas publicadas no host somente em desenvolvimento local.
# O Coolify usa docker-compose.yml sem docker-compose.override.yml, entao
# o proxy acessa as portas internas dos containers sem publicar no host.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8080
DATABASE_HOST_PORT=3306

# Portas internas dos containers.
# Normalmente so altere se a plataforma exigir.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# URLs usadas entre navegador, frontend e backend.
# Em producao, substitua localhost pelos dominios configurados no Coolify.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Banco de dados.
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=edutrackpro
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password

DB_HOST=database
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=edutrackpro

# Token de login (troque por uma string longa e aleatória em produção).
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria

# Google Identity Services: use o mesmo Client ID no backend e frontend
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
