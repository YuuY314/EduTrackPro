# Copie este arquivo para ".env" e preencha os valores.
# O ".env" NÃO vai para o Git (está no .gitignore).

PORT=3000

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=sistema_escolar

# Segredo usado para assinar os tokens de login (JWT).
# Use uma string longa e aleatória. Quem souber isso consegue forjar logins!
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria
JWT_EXPIRES=8h
