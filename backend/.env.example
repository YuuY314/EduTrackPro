# Mesmo Client ID configurado no frontend (Google Cloud Console)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GEMINI_API_KEY=sua_chave_do_google_ai_studio
GEMINI_MODEL=seu_modelo_do_gemini
#gemini-3.1-flash-lite
# Modelo reserva (opcional): usado se o principal estiver sobrecarregado (503),
# sem cota (429), fora do ar (500), lento (504) ou indisponível (404/403).
# Deixe vazio para não usar reserva. Use um modelo DIFERENTE do principal.
GEMINI_MODEL_RESERVA=gemini-3.5-flash-lite
